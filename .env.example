# Required: a worker key from your Meerkly dashboard (/devices).
MEERKLY_API_KEY=mk_wk_replace_me

# Optional
MEERKLY_WORKER_ID=worker-1
LOG_LEVEL=info
HEALTH_PORT=9090

# --- Pointing at a local stack -------------------------------------------
# Running from source on the host, localhost is the right answer:
# APP_ENV=development
#
# Running in Docker, it is NOT: localhost inside the container is the
# container. Name the host explicitly. docker-compose.yml already maps
# host.docker.internal, and the transport guard treats it as host-local, so
# plaintext to it works without ALLOW_INSECURE_GATEWAY.
# APP_ENV=development
# ACCOUNT_BASE_URL=http://host.docker.internal:3000
# GATEWAY_URL=ws://host.docker.internal:8080/v1/connect
#
# Only needed for plaintext to a genuinely remote host:
# ALLOW_INSECURE_GATEWAY=true

# Route ALL browser traffic through this proxy. A literal <sid> is replaced
# with a random 6-digit session id, generated at startup and rotated on every
# profile reset (MEERKLY_PROFILE_RESET_JOBS) so a fresh cookie jar pairs with a
# fresh exit IP; a crash relaunch keeps the current sid. A dead proxy fails the
# launch by design rather than leaking the host IP. Credentials are never logged.
# PROXY_URL=http://R5TfrmSltHC9-sid-<sid>-ttl-60:password@unlimited.proxiware.com:1337

# Pin the browser locale/timezone instead of deriving them from the egress IP.
# With a proxy set, "auto" derives from the proxy's exit country -- pin these to
# override that.
# MEERKLY_LOCALE=en-US
# MEERKLY_TIMEZONE=Europe/Madrid

# Jobs served before cookies and site storage are dropped (0 disables).
# A long-lived profile accumulates anti-abuse cookies and third-party trackers
# that link every crawled site into one identity, and both survive restarts --
# which is how a worker gets progressively blocked. The HTTP cache is kept.
MEERKLY_PROFILE_RESET_JOBS=50
